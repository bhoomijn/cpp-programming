
// switch_grade.cpp
#include <iostream>
using namespace std;

int main() {
    char grade;   
    cin >> grade;

    switch (grade) {
        case 'A': 
            cout << "Excellent!" << endl;
            break;
        case 'B': 
            cout << "Well done" << endl;
            break;
        case 'C': 
            cout << "Good" << endl;
            break;
        default: 
            cout << "Invalid grade." << endl;
            break;
    }

    return 0;
}
